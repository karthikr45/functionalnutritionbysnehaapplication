generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
  SUPER_ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  PACKAGE_SESSION
}

enum PackageBookingStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum DocumentType {
  PRESCRIPTION
  DIET_PLAN
  LAB_REPORT
  MEDICAL_REPORT
  CONSENT_FORM
  OTHER
}

enum TestimonialType {
  TESTIMONIAL
  CASE_STUDY
}

// ─── Auth Models (NextAuth) ────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String
  otp       String
  purpose   String // 'SIGNUP' | 'RESET_PASSWORD'
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

// ─── Core User Model ──────────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String
  phone           String?
  role            UserRole @default(PATIENT)
  image           String?
  isActive        Boolean  @default(true)
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  doctorProfile       DoctorProfile?
  patientProfile      PatientProfile?
  documents           Document[]
  messages            Message[]
  products            Product[]            @relation("ProductCreator")
  productReviews      ProductReview[]
  orders              Order[]
  orderStatusUpdates  OrderStatusHistory[]
  auditLogsPerformed  AuditLog[]           @relation("AuditBySuperAdmin")
  auditLogsTargeted   AuditLog[]           @relation("AuditImpersonatedUser")
  notifications       Notification[]
  testimonials        Testimonial[]
}

// ─── Doctor Profile ───────────────────────────────────────────────────────────

model DoctorProfile {
  id                  String  @id @default(cuid())
  userId              String  @unique
  bio                 String? @db.Text
  shortBio            String?
  specialization      String?
  qualifications      String?
  experience          Int? // years
  consultationFee     Float   @default(500)
  followUpFee         Float   @default(300)
  profileImage        String?
  isAcceptingPatients Boolean @default(true)

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability Availability[]
  blockedDates BlockedDate[]
  appointments Appointment[]  @relation("DoctorAppointments")
}

// ─── Patient Profile ──────────────────────────────────────────────────────────

model PatientProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  dateOfBirth        DateTime?
  gender             String?
  phone              String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  medicalHistory     String?   @db.Text
  allergies          String?
  currentMedications String?
  healthGoals        String?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  packageBookings PackageBooking[]
}

// ─── Doctor Availability ──────────────────────────────────────────────────────

model Availability {
  id           String  @id @default(cuid())
  doctorId     String
  dayOfWeek    Int // 0=Sun, 1=Mon ... 6=Sat
  startTime    String // "09:00"
  endTime      String // "17:00"
  slotDuration Int     @default(45) // minutes
  isActive     Boolean @default(true)

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model BlockedDate {
  id       String   @id @default(cuid())
  doctorId String
  date     DateTime
  reason   String?

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

// ─── Appointments ─────────────────────────────────────────────────────────────

model Appointment {
  id               String            @id @default(cuid())
  patientId        String
  doctorId         String
  date             DateTime
  startTime        String
  endTime          String
  status           AppointmentStatus @default(PENDING)
  type             AppointmentType   @default(CONSULTATION)
  healthConcerns   String?           @db.Text
  doctorNotes      String?           @db.Text
  dietPlanUrl      String?
  videoCallLink    String?
  packageBookingId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  patient        PatientProfile  @relation(fields: [patientId], references: [id])
  doctor         DoctorProfile   @relation("DoctorAppointments", fields: [doctorId], references: [id])
  packageBooking PackageBooking? @relation(fields: [packageBookingId], references: [id])
  payment        Payment?
  documents      Document[]
  messages       Message[]
}

// ─── Messages ────────────────────────────────────────────────────────────────

model Message {
  id            String   @id @default(cuid())
  appointmentId String
  senderId      String
  content       String   @db.Text
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id])
}

// ─── Packages ─────────────────────────────────────────────────────────────────

model Package {
  id          String  @id @default(cuid())
  name        String
  description String  @db.Text
  price       Float
  sessions    Int
  validity    Int // days
  features    Json // string[]
  serviceSlug String? // link to service/program slug (e.g. 'gut-reset-program')
  isActive    Boolean @default(true)
  isPopular   Boolean @default(false)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())

  bookings PackageBooking[]
}

model PackageBooking {
  id            String               @id @default(cuid())
  patientId     String
  packageId     String
  totalSessions Int
  usedSessions  Int                  @default(0)
  expiryDate    DateTime
  status        PackageBookingStatus @default(ACTIVE)
  createdAt     DateTime             @default(now())

  patient      PatientProfile @relation(fields: [patientId], references: [id])
  package      Package        @relation(fields: [packageId], references: [id])
  appointments Appointment[]
  payment      Payment?
}

// ─── Products & E-Commerce ──────────────────────────────────────────────────

model ProductCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  image       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String   @db.Text
  shortDescription  String?
  price             Float
  salePrice         Float?
  sku               String?  @unique
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  categoryId        String
  tags              Json     @default("[]") // ["POPULAR", "BEST_SELLER", "NEW_ARRIVAL"]
  images            Json     @default("[]") // [{ url, publicId }]
  benefits          Json     @default("[]") // string[]
  ingredients       String?  @db.Text
  howToUse          String?  @db.Text
  weight            String?
  isActive          Boolean  @default(true)
  isFeatured        Boolean  @default(false)
  sortOrder         Int      @default(0)
  avgRating         Float    @default(0)
  totalReviews      Int      @default(0)
  totalSold         Int      @default(0)
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category   ProductCategory @relation(fields: [categoryId], references: [id])
  createdBy  User            @relation("ProductCreator", fields: [createdById], references: [id])
  reviews    ProductReview[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  orderId    String
  rating     Int // 1-5
  title      String?
  comment    String?  @db.Text
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  @@unique([productId, userId, orderId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  status          OrderStatus @default(PENDING)
  subtotal        Float
  shippingFee     Float       @default(0)
  discount        Float       @default(0)
  totalAmount     Float
  shippingName    String
  shippingPhone   String
  shippingAddress String      @db.Text
  shippingCity    String
  shippingState   String
  shippingPincode String
  trackingNumber  String?
  trackingUrl     String?
  notes           String?     @db.Text
  adminNotes      String?     @db.Text
  cancelReason    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user          User                 @relation(fields: [userId], references: [id])
  items         OrderItem[]
  payment       Payment?
  statusHistory OrderStatusHistory[]
  reviews       ProductReview[]
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  productName  String
  productImage String?
  price        Float
  quantity     Int
  total        Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  note        String?
  updatedById String
  createdAt   DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  updatedBy User  @relation(fields: [updatedById], references: [id])
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  appointmentId     String?       @unique
  packageBookingId  String?       @unique
  orderId           String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  appointment    Appointment?    @relation(fields: [appointmentId], references: [id])
  packageBooking PackageBooking? @relation(fields: [packageBookingId], references: [id])
  order          Order?          @relation(fields: [orderId], references: [id])
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // APPOINTMENT_CONFIRMED, APPOINTMENT_CANCELLED, APPOINTMENT_REMINDER, MESSAGE, DOCUMENT, AI_INSIGHT, PAYMENT, PACKAGE_EXPIRY
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ─── Audit Logs ──────────────────────────────────────────────────────────────

model AuditLog {
  id                 String   @id @default(cuid())
  superAdminId       String
  impersonatedUserId String
  action             String // e.g. "VIEW_DASHBOARD", "UPDATE_APPOINTMENT", "CREATE_PACKAGE"
  entity             String? // e.g. "Appointment", "Package"
  entityId           String?
  details            String?  @db.Text
  ipAddress          String?
  createdAt          DateTime @default(now())

  superAdmin       User @relation("AuditBySuperAdmin", fields: [superAdminId], references: [id])
  impersonatedUser User @relation("AuditImpersonatedUser", fields: [impersonatedUserId], references: [id])
}

// ─── Theme Settings ──────────────────────────────────────────────────────────

model ThemeSettings {
  id           String   @id @default("global")
  primaryColor String   @default("#16a34a") // green-600
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Documents ────────────────────────────────────────────────────────────────

model Document {
  id            String       @id @default(cuid())
  uploadedById  String
  title         String
  type          DocumentType
  fileUrl       String
  filePublicId  String? // Cloudinary public_id for deletion
  fileType      String // mime type
  fileSize      Int?
  notes         String?
  appointmentId String?
  isShared      Boolean      @default(false) // shared between doctor and patient
  aiAnalysis    String?      @db.Text // Cached Claude analysis
  aiAnalyzedAt  DateTime?
  createdAt     DateTime     @default(now())

  uploadedBy  User         @relation(fields: [uploadedById], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
}

// ─── Testimonials & Case Studies ──────────────────────────────────────────────
// Doctor-curated success stories shown on the public homepage. Same model
// supports both short testimonials and longer case studies (distinguished
// by `type`). Authored by the doctor (User with role DOCTOR).

model Testimonial {
  id          String          @id @default(cuid())
  authorId    String // doctor user.id who created the entry
  patientName String // patient name shown publicly (or anonymized)
  type        TestimonialType @default(TESTIMONIAL)
  title       String?
  content     String          @db.Text
  rating      Int             @default(5) // 1-5
  imageUrl    String? // optional patient photo / outcome chart
  isPublished Boolean         @default(true)
  isFeatured  Boolean         @default(false)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([isPublished, sortOrder])
}
